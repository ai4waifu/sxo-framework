{
    "name": "@sxo/mathematica",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "SXO Mathematica / Wolfram dialect API and wolframscript CLI",
    "license": "Apache-2.0",
    "bin": {
        "wolframscript": "./bin/wolframscript.mjs"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./cli": {
            "types": "./dist/cli.d.ts",
            "default": "./dist/cli.js"
        },
        "./jupyter": {
            "types": "./dist/jupyter/install.d.ts",
            "default": "./dist/jupyter/install.js"
        }
    },
    "files": [
        "dist",
        "bin",
        "locales",
        "README.md"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "vitest run"
    },
    "dependencies": {
        "@vmz/commander": "0.1.26",
        "@vmz/diagnostic": "0.1.26"
    },
    "optionalDependencies": {
        "@sxo/sxo-win32-x64": "workspace:*",
        "@sxo/sxo-linux-x64": "workspace:*",
        "@sxo/sxo-darwin-arm64": "workspace:*",
        "@sxo/sxo-darwin-x64": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4"
    }
}
