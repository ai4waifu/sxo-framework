{
    "name": "@sxo/matlab",
    "version": "0.0.3",
    "private": true,
    "type": "module",
    "description": "MATLAB-oriented SXO frontend for parsing, lowering, and rendering, not a kernel",
    "repository": {
        "type": "git",
        "url": "https://github.com/vm-z/sxo-framework.git",
        "directory": "projects/runtimes/sxo-matlab"
    },
    "homepage": "https://github.com/vm-z/sxo-framework#readme",
    "bugs": {
        "url": "https://github.com/vm-z/sxo-framework/issues"
    },
    "keywords": [
        "sxo",
        "matlab",
        "parser",
        "symbolic-computation",
        "frontend"
    ],
    "license": "Apache-2.0",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run",
        "report:features": "vite-node ./tests/feature-matrix/report.ts"
    },
    "optionalDependencies": {
        "@sxo/sxo-win32-x64": "workspace:*",
        "@sxo/sxo-linux-x64": "workspace:*",
        "@sxo/sxo-darwin-arm64": "workspace:*",
        "@sxo/sxo-darwin-x64": "workspace:*"
    },
    "devDependencies": {
        "@sxo/harness": "workspace:*",
        "@types/node": "^22.15.0",
        "typescript": "^5.8.3",
        "vite-node": "^3.2.4",
        "vitest": "^3.2.4"
    }
}
