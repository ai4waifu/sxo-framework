{
    "name": "@sxo/matlab",
    "version": "0.0.2",
    "private": true,
    "type": "module",
    "description": "SXO MATLAB dialect frontend (oak-matlab → Athena Term); not a kernel",
    "license": "Apache-2.0",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./feature-matrix": {
            "types": "./dist/feature-matrix/index.d.ts",
            "default": "./dist/feature-matrix/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run",
        "report:features": "node ./dist/feature-matrix/cli.js"
    },
    "optionalDependencies": {
        "@sxo/sxo-win32-x64": "workspace:*",
        "@sxo/sxo-linux-x64": "workspace:*",
        "@sxo/sxo-darwin-arm64": "workspace:*",
        "@sxo/sxo-darwin-x64": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4"
    }
}
