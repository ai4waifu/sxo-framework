{
    "name": "@sxo/core",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "SXO simple-math symbolic API (no Mathematica / Wolfram)",
    "license": "Apache-2.0",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
