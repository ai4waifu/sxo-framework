{
    "name": "@sxo/harness",
    "version": "0.0.3",
    "private": true,
    "type": "module",
    "description": "Private R&D package: feature-matrix builders, validators, runners, and reporters for dialect acceptance. Not a product runtime.",
    "repository": {
        "type": "git",
        "url": "https://github.com/ai4waifu/sxo-framework.git",
        "directory": "projects/tooling/sxo-harness"
    },
    "homepage": "https://github.com/ai4waifu/sxo-framework/tree/dev/projects/tooling/sxo-harness",
    "bugs": {
        "url": "https://github.com/ai4waifu/sxo-framework/issues"
    },
    "keywords": [
        "sxo",
        "feature-matrix",
        "harness",
        "private"
    ],
    "license": "Apache-2.0",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./matrix": {
            "types": "./dist/matrix/index.d.ts",
            "default": "./dist/matrix/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run",
        "report:features": "vite-node ./src/report-features.cli.ts"
    },
    "devDependencies": {
        "@sxo/mathematica": "workspace:*",
        "@sxo/matlab": "workspace:*",
        "@types/node": "^22.15.0",
        "typescript": "^5.8.3",
        "vite-node": "^3.2.4",
        "vitest": "^3.2.4"
    }
}
