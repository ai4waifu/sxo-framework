<template>
  <main class="page-play">
    <section class="page-head" aria-labelledby="play-title">
      <p class="page-head__overline">Playground</p>
      <h1 id="play-title">演练场</h1>
      <p class="page-head__lede">
        浏览器内的 <code>@dxo/lite</code> 实演：输入两个 2×2 f32 矩阵（行主序，各四个数），执行 matmul 或
        add。WASM 内核来自 <code>@dxo/lite-unknown-wasm32</code>，经 <code>public/dxo_lite_bg.wasm</code> 装载。
      </p>
    </section>

    <section class="panel" aria-labelledby="runtime-title">
      <h2 id="runtime-title">运行时</h2>
      <p class="panel__note">{{ status }}</p>
      <dl class="probe__list">
        <div><dt>lite</dt><dd>{{ liteVersion }}</dd></div>
        <div><dt>backend</dt><dd>{{ backend }}</dd></div>
        <div><dt>wasm</dt><dd>{{ wasmVersion }}</dd></div>
        <div><dt>interimHostF32</dt><dd>{{ wasmInterim }}</dd></div>
        <div><dt>webgpu probe</dt><dd>{{ webgpu }}</dd></div>
      </dl>
    </section>

    <section class="panel" aria-labelledby="ops-title">
      <h2 id="ops-title">2×2 f32 运算</h2>
      <p class="panel__note">行主序矩阵，每个四个数，空格或逗号分隔。</p>
      <div class="ops">
        <label class="ops__field">
          <span>A</span>
          <input type="text" :value="aText" @input="onA" spellcheck="false" autocomplete="off" />
        </label>
        <label class="ops__field">
          <span>B</span>
          <input type="text" :value="bText" @input="onB" spellcheck="false" autocomplete="off" />
        </label>
        <div class="ops__actions">
          <button type="button" class="ops__button ops__button--primary" @click="() => this.runMatmul()">matmul</button>
          <button type="button" class="ops__button" @click="() => this.runAdd()">add</button>
          <button type="button" class="ops__button" @click="() => this.loadIdentity()">A·I 演示</button>
          <button type="button" class="ops__button" @click="() => this.loadOnes()">全一矩阵</button>
        </div>
        <div class="code-panel">
          <div class="code-panel__bar"><span>输出</span><button type="button" class="code-panel__copy" @click="() => this.copyResult()">复制</button></div>
          <pre class="code-panel__pre"><code>{{ result }}</code></pre>
        </div>
      </div>
    </section>
  </main>
</template>

<style>
  .page-play {
    flex: 1;
    max-width: var(--vmz-layout-max-width, 73.75rem);
    width: 100%;
    margin: 0 auto;
    padding: 56px 24px 72px;
  }
  .page-head {
    max-width: 44em;
  }
  .page-head__overline {
    margin: 0;
    font-family: var(--vmz-font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--vmz-brand-primary);
  }
  .page-head h1 {
    margin: 12px 0 0;
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 700;
    line-height: 1.15;
  }
  .page-head__lede {
    margin: 14px 0 0;
    color: var(--vmz-text-steel);
    line-height: 1.7;
  }
  .page-head__lede code {
    font-family: var(--vmz-font-mono);
    font-size: 0.92em;
  }
  .panel {
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid var(--vmz-line-strong);
  }
  .panel h2 {
    margin: 0;
    font-size: clamp(22px, 2.2vw, 28px);
    font-weight: 700;
  }
  .panel__note {
    margin: 10px 0 0;
    font-size: 14px;
    color: var(--vmz-text-faint);
    line-height: 1.7;
  }
  .probe__list {
    margin: 20px 0 0;
    border-top: 1px solid var(--vmz-line-default);
  }
  .probe__list div {
    display: grid;
    grid-template-columns: minmax(170px, 15rem) 1fr;
    gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid var(--vmz-line-default);
    font-family: var(--vmz-font-mono);
    font-size: 13px;
    line-height: 1.6;
  }
  .probe__list dt {
    color: var(--vmz-text-faint);
  }
  .probe__list dd {
    margin: 0;
    color: var(--vmz-text-ink);
    overflow-wrap: anywhere;
  }
  .ops {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 40rem;
  }
  .ops__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--vmz-font-mono);
    font-size: 13px;
    color: var(--vmz-text-faint);
  }
  .ops__field input {
    min-height: 44px;
    font-family: var(--vmz-font-mono);
    font-size: 14px;
    padding: 0 12px;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-md);
    background: var(--vmz-surface-paper);
    color: var(--vmz-text-ink);
  }
  .ops__field input:focus-visible {
    outline: none;
    border-color: var(--vmz-brand-primary);
    box-shadow: 0 0 0 2px var(--vmz-focus-ring);
  }
  .ops__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .ops__button {
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--vmz-action-secondary-border);
    border-radius: var(--vmz-radius-md);
    background: var(--vmz-action-secondary-background);
    color: var(--vmz-action-secondary-foreground);
    font-family: var(--vmz-font-mono);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 120ms ease-out, border-color 120ms ease-out, color 120ms ease-out;
  }
  .ops__button:hover {
    background: var(--vmz-action-secondary-hover);
  }
  .ops__button:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--vmz-focus-ring);
  }
