    overflow: hidden;
  }
  .code-panel__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 6px 6px 14px;
    border-bottom: 1px solid var(--vmz-line-default);
    font-family: var(--vmz-font-mono);
    font-size: 12px;
    color: var(--vmz-text-faint);
  }
  .code-panel__copy {
    min-height: 32px;
    padding: 0 12px;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-sm);
    background: var(--vmz-surface-page);
    color: var(--vmz-text-steel);
    font-family: var(--vmz-font-mono);
    font-size: 12px;
    cursor: pointer;
    transition: background-color 120ms ease-out, color 120ms ease-out;
  }
  .code-panel__copy:hover {
    color: var(--vmz-text-ink);
    background: var(--vmz-surface-mist);
  }
  .code-panel__copy:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--vmz-focus-ring);
  }
  .code-panel__pre {
    margin: 0;
    padding: 16px 18px;
    overflow-x: auto;
    min-height: 3.5em;
  }
  .code-panel__pre code {
    font-family: var(--vmz-font-mono);
    font-size: 14px;
    line-height: 1.7;
    color: var(--vmz-text-ink);
    white-space: pre;
  }
  @media (max-width: 759.98px) {
    .page-play {
      padding: 40px 20px 56px;
    }
    .page-head h1 {
      font-size: 28px;
    }
    .probe__list div {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .ops__actions .ops__button {
      flex: 1 1 44%;
    }
    .code-panel__copy {
      min-height: 44px;
      padding: 0 16px;
    }
  }
</style>

<script client>
import { openHomepageRuntime } from '../lib/lite-probe.ts';

function parseNums(text) {
    return text
        .trim()
        .split(/[\s,]+/)
        .filter(Boolean)
        .map((s) => Number(s));
}

function formatMatrix(out) {
    return `[${out[0]}, ${out[1]}]\n[${out[2]}, ${out[3]}]`;
}

export default class PlaygroundPage {
    status = '正在启动运行时…';
    liteVersion = '';
    backend = '';
    wasmVersion = '';
    wasmInterim = '';
    webgpu = '';
    aText = '1, 2, 3, 4';
    bText = '1, 0, 0, 1';
    result = '运行时就绪后点击 matmul 或 add。';
    #rt = null;

    onA(e) {
        this.aText = e.target?.value ?? this.aText;
    }

    onB(e) {
        this.bText = e.target?.value ?? this.bText;
    }

    async onMount() {
        try {
            const opened = await openHomepageRuntime();
            this.#rt = opened.runtime;
            this.liteVersion = opened.version;
            this.backend = this.#rt.capabilities.backend;
            this.webgpu = String(this.#rt.capabilities.webgpu);
            const wasm = this.#rt.capabilities.wasm;
            this.wasmVersion = wasm?.version ?? '(未装载 — 缺少 public/dxo_lite_bg.wasm)';
            this.wasmInterim = String(wasm?.interimHostF32 ?? false);
            this.status = wasm ? '就绪 · WASM f32 内核' : '就绪 · JS 宿主内核（缺 WASM）';
            this.result = '运行时就绪。点击 matmul 或 add。';
        } catch (err) {
            this.status = err instanceof Error ? err.message : String(err);
            this.result = 'createRuntime 失败 — 检查控制台与 WASM 装载。';
        }
    }

    onDestroy() {
        this.#rt?.destroy();
        this.#rt = null;
    }

    loadIdentity() {
        this.aText = '1, 2, 3, 4';
        this.bText = '1, 0, 0, 1';
        this.result = '';
    }

    loadOnes() {
        this.aText = '1, 1, 1, 1';
        this.bText = '1, 1, 1, 1';
        this.result = '';
    }

    #parsePair() {
        const aData = parseNums(this.aText);
        const bData = parseNums(this.bText);
        if (
            aData.length !== 4 ||
            bData.length !== 4 ||
            aData.some((n) => Number.isNaN(n)) ||
            bData.some((n) => Number.isNaN(n))
        ) {
            return null;
        }
        return { aData, bData };
    }

    async runMatmul() {
        if (!this.#rt) return;
        const pair = this.#parsePair();
        if (!pair) {
            this.result = 'A 与 B 各需要 4 个有限数（2×2）';
            return;
        }
        try {
            const a = this.#rt.tensor(pair.aData, [2, 2]);
            const b = this.#rt.tensor(pair.bData, [2, 2]);
            const c = a.matmul(b);
            await c.ready();
            const out = await c.toArray();
            this.result = `matmul  [2,2] × [2,2] → [2,2]\n${formatMatrix(out)}`;
        } catch (err) {
            this.result = err instanceof Error ? err.message : String(err);
        }
    }

    async runAdd() {
        if (!this.#rt) return;
        const pair = this.#parsePair();
        if (!pair) {
            this.result = 'A 与 B 各需要 4 个有限数';
            return;
        }
        try {
            const a = this.#rt.tensor(pair.aData, [2, 2]);
            const b = this.#rt.tensor(pair.bData, [2, 2]);
            const c = a.add(b);
            const out = await c.toArray();
            this.result = `add  [2,2] + [2,2] → [2,2]\n${formatMatrix(out)}`;
        } catch (err) {
            this.result = err instanceof Error ? err.message : String(err);
        }
    }

    async copyResult() {
        const text = String(this.result || '');
        if (!text || typeof navigator === 'undefined' || !navigator.clipboard?.writeText) return;
        try {
            await navigator.clipboard.writeText(text);
        } catch {
            /* ignore */
        }
    }
}
</script>
