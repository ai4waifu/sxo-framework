<template>
  <main class="page-lite">
    <section class="page-head" aria-labelledby="lite-title">
      <p class="page-head__overline">Runtime Probe</p>
      <h1 id="lite-title">@dxo/lite 探针</h1>
      <p class="page-head__lede">
        浏览器内的真实运行时：异步门面 <code>createRuntime</code>，GPU WASM 门面未链接时回退到宿主 f32。TypeScript
        不持有 GPUDevice，WebGL 不是张量后端。
      </p>
    </section>

    <section class="panel" aria-labelledby="probe-title">
      <h2 id="probe-title">探测结果</h2>
      <p class="panel__note">以下数值来自本页加载时真实执行的 <code>createRuntime</code> 能力查询与一次 matmul 回代。</p>
      <dl class="probe__list">
        <div><dt>version()</dt><dd>{{ liteVersion }}</dd></div>
        <div><dt>capabilities.backend</dt><dd>{{ liteBackend }}</dd></div>
        <div><dt>wasm</dt><dd>{{ liteWasm }}</dd></div>
        <div><dt>webgpu</dt><dd>{{ liteWebgpu }}</dd></div>
        <div><dt>gpuBackendReady</dt><dd>{{ liteGpuReady }}</dd></div>
        <div><dt>webglTensorBackend</dt><dd>{{ liteWebgl }}</dd></div>
        <div><dt>Tensor</dt><dd>{{ liteTensorClass }}</dd></div>
        <div><dt>matmul A·I = A</dt><dd>{{ liteMatmul }}</dd></div>
      </dl>
    </section>

    <section class="panel" aria-labelledby="selftest-title">
      <h2 id="selftest-title">Node 自测</h2>
      <p class="panel__note">无浏览器环境下的本地与 CI 验证命令。</p>
      <div class="code-panel">
        <div class="code-panel__bar"><span>shell</span><button type="button" class="code-panel__copy" @click="() => this.copySelfTest()">复制</button></div>
        <pre class="code-panel__pre"><code>{{ selfTestSample }}</code></pre>
      </div>
    </section>
  </main>
</template>

<style>
  .page-lite {
    flex: 1;
    max-width: var(--vmz-layout-max-width, 73.75rem);
    width: 100%;
    margin: 0 auto;
    padding: 56px 24px 72px;
  }
  .page-head {
    max-width: 44em;
  }
  .page-head__overline {
    margin: 0;
    font-family: var(--vmz-font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--vmz-brand-primary);
  }
  .page-head h1 {
    margin: 12px 0 0;
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 700;
    line-height: 1.15;
  }
  .page-head__lede {
    margin: 14px 0 0;
    color: var(--vmz-text-steel);
    line-height: 1.7;
  }
  .page-head__lede code {
    font-family: var(--vmz-font-mono);
    font-size: 0.92em;
  }
  .panel {
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid var(--vmz-line-strong);
  }
  .panel h2 {
    margin: 0;
    font-size: clamp(22px, 2.2vw, 28px);
    font-weight: 700;
  }
  .panel__note {
    margin: 10px 0 0;
    font-size: 14px;
    color: var(--vmz-text-faint);
    line-height: 1.7;
  }
  .panel__note code {
    font-family: var(--vmz-font-mono);
    font-size: 0.92em;
  }
  .probe__list {
    margin: 20px 0 0;
    border-top: 1px solid var(--vmz-line-default);
  }
  .probe__list div {
    display: grid;
    grid-template-columns: minmax(170px, 15rem) 1fr;
    gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid var(--vmz-line-default);
    font-family: var(--vmz-font-mono);
    font-size: 13px;
    line-height: 1.6;
  }
  .probe__list dt {
    color: var(--vmz-text-faint);
  }
  .probe__list dd {
    margin: 0;
    color: var(--vmz-text-ink);
    overflow-wrap: anywhere;
  }
  .code-panel {
    margin-top: 20px;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-md);
    overflow: hidden;
  }
  .code-panel__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 6px 6px 14px;
    border-bottom: 1px solid var(--vmz-line-default);
    font-family: var(--vmz-font-mono);
    font-size: 12px;
    color: var(--vmz-text-faint);
  }
  .code-panel__copy {
    min-height: 32px;
    padding: 0 12px;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-sm);
    background: var(--vmz-surface-page);
    color: var(--vmz-text-steel);
    font-family: var(--vmz-font-mono);
    font-size: 12px;
    cursor: pointer;
    transition: background-color 120ms ease-out, color 120ms ease-out;
  }
  .code-panel__copy:hover {
    color: var(--vmz-text-ink);
    background: var(--vmz-surface-mist);
  }
  .code-panel__copy:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--vmz-focus-ring);
