<template>
  <div class="sxo-home">
    <header class="sxo-site-header">
      <Link class="sxo-site-header__brand" href="/"><strong>SXO</strong><span>Symbolic computing for every language</span></Link>
      <nav class="sxo-site-header__nav" aria-label="Primary">
        <Link href="/lite">Compute</Link>
        <Link href="/playground">Dialects</Link>
        <Link href="/playground">Playground</Link>
      </nav>
    </header>
    <main>
      <section class="sxo-home__hero" aria-labelledby="sxo-hero-title">
        <Badge tone="brand">Scientific computing · Symbolic by design</Badge>
        <h1 id="sxo-hero-title">Make mathematics executable.</h1>
        <p class="sxo-home__lede">
          A Rust-native computer algebra system with TypeScript adapters for equations, transformations, and domain-specific mathematics.
        </p>
        <div class="sxo-home__actions">
          <Link href="/playground"><Button type="button" variant="primary">Explore the workbench</Button></Link>
          <Link href="/lite"><Button type="button" variant="secondary">Read the engine</Button></Link>
        </div>
      </section>

      <section class="sxo-home__grid" aria-label="Scientific computing surfaces">
        <Card title="One expression, many dialects" description="Parse, simplify, differentiate, and render through a shared symbolic core.">
          <CodeBlock
            :code="installSample"
            caption="shell"
            copy-label="Copy"
            @copy="() => this.copyInstall()"
          />
        </Card>
        <Card title="A native mathematical engine" description="Athena provides exact symbolic semantics; SXO connects them to tools people already use.">
          <dl class="sxo-home__probe">
            <div><dt>version</dt><dd>{{ liteVersion }}</dd></div>
            <div><dt>backend</dt><dd>{{ liteBackend }}</dd></div>
            <div><dt>wasm</dt><dd>{{ liteWasm }}</dd></div>
            <div><dt>Tensor</dt><dd>{{ liteTensorClass }}</dd></div>
            <div><dt>matmul</dt><dd>{{ liteMatmul }}</dd></div>
          </dl>
          <Callout tone="info">
            Mathematica, MATLAB, and simple-math surfaces can share one expression model without flattening their differences.
          </Callout>
        </Card>
      </section>
    </main>
  </div>
</template>

<style>
  .sxo-site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--vmz-line-default, #e2e8f0);
  }
  .sxo-site-header__brand {
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--vmz-text-ink, #0f172a);
  }
  .sxo-site-header__nav {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .sxo-home {
    max-width: 56rem;
    margin: 0 auto;
    padding: 0 1.25rem 3rem;
  }
  .sxo-home__hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1.5rem 0 2rem;
  }
  .sxo-home__hero h1 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.15;
    color: var(--vmz-text-ink, #0f172a);
  }
  .sxo-home__lede {
    margin: 0;
    max-width: 40rem;
    color: var(--vmz-text-steel, #475569);
    line-height: 1.55;
  }
  .sxo-home__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  .sxo-home__grid {
    display: grid;
    gap: 1.25rem;
  }
  .sxo-home__probe {
    margin: 0 0 0.75rem;
    display: grid;
    gap: 0.35rem;
  }
  .sxo-home__probe div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.5rem;
    font-family: var(--vmz-font-mono, ui-monospace, monospace);
    font-size: 0.85rem;
  }
  .sxo-home__probe dt {
    color: var(--vmz-text-steel, #475569);
  }
  .sxo-home__probe dd {
    margin: 0;
  }
  @media (min-width: 720px) {
    .sxo-home__grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
</style>

<script client>
import { probeLite } from '../lib/lite-probe.ts';

export default class IndexPage {
    installSample = 'pnpm add @dxo/lite@0.0.10';
    liteVersion = '…';
    liteBackend = '…';
    liteWasm = '…';
    liteTensorClass = '…';
    liteMatmul = '…';

    async onMount() {
        const probe = await probeLite();
        this.liteVersion = probe.version;
        this.liteBackend = probe.backend;
        this.liteWasm = probe.wasmVersion;
        this.liteTensorClass = probe.tensorClass;
        this.liteMatmul = probe.matmulOk ? 'ok' : 'fail';
    }

    async copyInstall() {
        const text = String(this.installSample || '');
        if (!text || typeof navigator === 'undefined' || !navigator.clipboard?.writeText) return;
        try {
            await navigator.clipboard.writeText(text);
        } catch {
            /* ignore */
        }
    }
}
</script>

