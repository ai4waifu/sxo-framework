<script client>
export default class SiteHeader {
    homeCurrent = null;
    docsCurrent = null;
    liteCurrent = null;
    playgroundCurrent = null;

    onMount() {
        const path = typeof location !== "undefined" ? location.pathname : "/";
        this.homeCurrent = path === "/" || path === "" ? "page" : null;
        this.docsCurrent = path.indexOf("/d") === 0 ? "page" : null;
        this.liteCurrent = path.indexOf("/lite") === 0 ? "page" : null;
        this.playgroundCurrent = path.indexOf("/playground") === 0 ? "page" : null;
    }
}
</script>
