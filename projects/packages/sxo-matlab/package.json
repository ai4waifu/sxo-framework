{
    "name": "@sxo/matlab",
    "version": "0.0.3",
    "private": true,
    "type": "module",
    "description": "MATLAB dialect frontend: parse, evaluate, and render via the SXO native addon. Not a MATLAB runtime or toolbox.",
    "repository": {
        "type": "git",
        "url": "https://github.com/ai4waifu/sxo-framework.git",
        "directory": "projects/packages/sxo-matlab"
    },
    "homepage": "https://github.com/ai4waifu/sxo-framework/tree/dev/projects/packages/sxo-matlab",
    "bugs": {
        "url": "https://github.com/ai4waifu/sxo-framework/discussions/new?category=bugs"
    },
    "keywords": [
        "sxo",
        "matlab",
        "dialect",
        "napi"
    ],
    "license": "Apache-2.0",
    "sxo": {
        "featureMatrix": "./tests/feature-matrix/index.ts"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run",
        "report:features": "vite-node ./tests/feature-matrix/report.ts"
    },
    "dependencies": {
        "@sxo/core": "workspace:*"
    },
    "optionalDependencies": {
        "@sxo/sxo-win32-x64": "workspace:*",
        "@sxo/sxo-linux-x64": "workspace:*",
        "@sxo/sxo-darwin-arm64": "workspace:*",
        "@sxo/sxo-darwin-x64": "workspace:*"
    },
    "devDependencies": {
        "@sxo/harness": "workspace:*",
        "@types/node": "^22.15.0",
        "typescript": "^5.8.3",
        "vite-node": "^3.2.4",
        "vitest": "^3.2.4"
    }
}
