{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "paths": {
            "@sxo/mathematica": ["./src/index.ts"],
            "@sxo/mathematica/cli": ["./src/cli.ts"],
            "@sxo/mathematica/jupyter": ["./src/jupyter/install.ts"]
        }
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
