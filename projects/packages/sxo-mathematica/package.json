{
    "name": "@sxo/mathematica",
    "version": "0.0.5",
    "private": true,
    "type": "module",
    "description": "Mathematica / Wolfram Language frontend: parse, evaluate, and render via the SXO native addon. Includes wolframscript CLI and Jupyter kernel install helpers.",
    "repository": {
        "type": "git",
        "url": "https://github.com/ai4waifu/sxo-framework.git",
        "directory": "projects/packages/sxo-mathematica"
    },
    "homepage": "https://github.com/ai4waifu/sxo-framework/tree/dev/projects/packages/sxo-mathematica",
    "bugs": {
        "url": "https://github.com/ai4waifu/sxo-framework/discussions/new?category=bugs"
    },
    "keywords": [
        "sxo",
        "mathematica",
        "wolfram",
        "wolfram-language",
        "jupyter"
    ],
    "license": "Apache-2.0",
    "sxo": {
        "featureMatrix": "./tests/feature-matrix/index.ts"
    },
    "bin": {
        "wolframscript": "./bin/wolframscript.mjs"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./cli": {
            "types": "./dist/cli.d.ts",
            "default": "./dist/cli.js"
        },
        "./jupyter": {
            "types": "./dist/jupyter/install.d.ts",
            "default": "./dist/jupyter/install.js"
        }
    },
    "files": [
        "dist",
        "bin",
        "locales",
        "README.md"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run",
        "report:features": "vite-node ./tests/feature-matrix/report.ts"
    },
    "dependencies": {
        "@sxo/core": "workspace:*",
        "@vmz/commander": "0.1.26",
        "@vmz/diagnostic": "0.1.26"
    },
    "optionalDependencies": {
        "@sxo/sxo-win32-x64": "workspace:*",
        "@sxo/sxo-linux-x64": "workspace:*",
        "@sxo/sxo-darwin-arm64": "workspace:*",
        "@sxo/sxo-darwin-x64": "workspace:*"
    },
    "devDependencies": {
        "@sxo/harness": "workspace:*",
        "@types/node": "^22.15.0",
        "typescript": "^5.8.3",
        "vite-node": "^3.2.4",
        "vitest": "^3.2.4"
    }
}
