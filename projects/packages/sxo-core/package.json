{
    "name": "@sxo/core",
    "version": "0.0.3",
    "private": true,
    "type": "module",
    "description": "Loads the SXO N-API addon and exposes a thin Expression API for the simple-math dialect.",
    "repository": {
        "type": "git",
        "url": "https://github.com/ai4waifu/sxo-framework.git",
        "directory": "projects/packages/sxo-core"
    },
    "homepage": "https://github.com/ai4waifu/sxo-framework/tree/dev/projects/packages/sxo-core",
    "bugs": {
        "url": "https://github.com/ai4waifu/sxo-framework/issues"
    },
    "keywords": [
        "sxo",
        "napi",
        "native-addon",
        "simple-math"
    ],
    "license": "Apache-2.0",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run"
    },
    "optionalDependencies": {
        "@sxo/sxo-win32-x64": "workspace:*",
        "@sxo/sxo-linux-x64": "workspace:*",
        "@sxo/sxo-darwin-arm64": "workspace:*",
        "@sxo/sxo-darwin-x64": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4"
    }
}
